rules_version = '2';

// PH1–PH4: listing photos. Only verified UW users can read them, and users
// can only upload images (under 10 MB) into their own folder.
service firebase.storage {
  match /b/{bucket}/o {

    function isUwUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@uw[.]edu$');
    }

    match /listingPhotos/{uid}/{fileName} {
      allow read: if isUwUser();
      allow create: if isUwUser()
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
