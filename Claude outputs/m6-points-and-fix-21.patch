+++ b/tests/firestore.rules.test.js
@@ -508,3 +508,72 @@ test('lender cannot reactivate an On Loan listing before receiving the return',
     status: 'Active', approvedRequestId: null,
   }));
 });
+
+// #22 Points system: G5.1–G5.2, P1–P3.
+test('giveaway pickup awards the giver 15 points exactly once', async () => {
+  const requestId = 'item-1_requester-1';
+  await testEnv.withSecurityRulesDisabled(async context => {
+    const db = context.firestore();
+    await setDoc(doc(db, 'requests/' + requestId), {
+      listingId: 'item-1', listingType: 'give', ownerId: 'owner-1',
+      requesterId: 'requester-1', status: 'Approved', stage: 'Approved',
+    });
+    await setDoc(doc(db, 'users/owner-1'), { totalPoints: 7 });
+  });
+  const giver = uwContext('owner-1');
+  const record = (points) => ({
+    requestId, userId: 'owner-1', points,
+    reason: 'Completed giveaway transaction', createdAt: new Date(),
+  });
+
+  // Pickup without the points is refused.
+  await assertFails(updateDoc(doc(giver, 'requests/' + requestId), { stage: 'Pickup' }));
+
+  // Wrong amount is refused.
+  const wrong = writeBatch(giver);
+  wrong.update(doc(giver, 'requests/' + requestId), { stage: 'Pickup' });
+  wrong.update(doc(giver, 'users/owner-1'), { totalPoints: 107, lastPointsRequestId: requestId });
+  wrong.set(doc(giver, 'pointsRecords/' + requestId + '_owner-1'), record(100));
+  await assertFails(wrong.commit());
+
+  // The recipient cannot be awarded giveaway points.
+  const recipientAward = writeBatch(giver);
+  recipientAward.update(doc(giver, 'requests/' + requestId), { stage: 'Pickup' });
+  recipientAward.set(doc(giver, 'pointsRecords/' + requestId + '_requester-1'), {
+    ...record(15), userId: 'requester-1',
+  });
+  await assertFails(recipientAward.commit());
+
+  const pickup = writeBatch(giver);
+  pickup.update(doc(giver, 'requests/' + requestId), { stage: 'Pickup' });
+  pickup.update(doc(giver, 'users/owner-1'), { totalPoints: 22, lastPointsRequestId: requestId });
+  pickup.set(doc(giver, 'pointsRecords/' + requestId + '_owner-1'), record(15));
+  await assertSucceeds(pickup.commit());
+
+  const user = await getDoc(doc(giver, 'users/owner-1'));
+  if (user.data().totalPoints !== 22) throw new Error('Giver did not get 15 points.');
+
+  // No second award for the same transaction.
+  await assertFails(updateDoc(doc(giver, 'users/owner-1'), { totalPoints: 37, lastPointsRequestId: requestId }));
+});
+
+test('sell pickup still works without points', async () => {
+  const requestId = 'item-1_requester-1';
+  await testEnv.withSecurityRulesDisabled(async context => {
+    await setDoc(doc(context.firestore(), 'requests/' + requestId), {
+      listingId: 'item-1', listingType: 'sell', ownerId: 'owner-1',
+      requesterId: 'requester-1', status: 'Approved', stage: 'Approved',
+    });
+  });
+  const buyer = uwContext('requester-1');
+  await assertSucceeds(updateDoc(doc(buyer, 'requests/' + requestId), { stage: 'Pickup' }));
+});
+
+test('users can create only their own profile, starting at 0 points', async () => {
