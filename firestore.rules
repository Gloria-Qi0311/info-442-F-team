rules_version = '2';

// NF7: only signed-in, verified UW accounts can read or write app data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isUwUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@uw[.]edu$');
    }

    // Setup check used by Issue 1.1. Keep test data behind UW verification.
    match /healthChecks/{id} {
      allow read: if isUwUser();
      allow create: if isUwUser()
        && request.resource.data.keys().hasOnly(['message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 100;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isUwUser();
      allow create, update: if isUwUser() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /pickupAreas/{id} {
      allow read: if isUwUser();
      allow write: if false;
    }

    match /listings/{id} {
      allow read: if isUwUser();
      allow create: if isUwUser() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isUwUser() && resource.data.ownerId == request.auth.uid;
      // LS9: any UW user may only flip an expired Active listing to Inactive.
      allow update: if isUwUser()
        && resource.data.status == 'Active'
        && request.resource.data.status == 'Inactive'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && timestamp.date(
             int(resource.data.availableUntil.split('-')[0]),
             int(resource.data.availableUntil.split('-')[1]),
             int(resource.data.availableUntil.split('-')[2])
           ) + duration.value(1, 'd') < request.time;
    }

    match /requests/{id} {
      allow read, write: if isUwUser();
    }
    match /confirmationPhotos/{id} {
      allow read, write: if isUwUser();
    }
    match /ratings/{id} {
      allow read, write: if isUwUser();
    }
    match /pointsRecords/{id} {
      allow read: if isUwUser();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
